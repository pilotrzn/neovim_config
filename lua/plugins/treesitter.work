return {
        "nvim-treesitter/nvim-treesitter",
        lazy = false,
        branch = "master",
        build = ":TSUpdate",
        config = function()
            require("nvim-treesitter").setup({
                auto_install = true,
                highlight = {
                    enable = true
                },
                additional_vim_regex_highlighting = false,
            })
            require('nvim-treesitter').install {
                "yaml",
                "python",
                "lua",
                "vim",
                "bash",
                "json",
                "markdown",
                "markdown_inline",
                "jinja"
            }
        end,
    }
